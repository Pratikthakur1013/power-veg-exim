# ============================================================
#  Power Veg Exim — Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to git.
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# ── JWT Session ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHARACTER_SECRET_KEY_MINIMUM

# ── Firebase Client (VITE_ prefix = safe for browser) ────────
# Get from Firebase Console → Project Settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# ── Firebase Admin SDK (SERVER ONLY — never expose to browser) ──
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Email (Gmail SMTP) ────────────────────────────────────────
# App Password setup: https://myaccount.google.com/apppasswords
# Enable 2FA on Gmail first, then create an App Password for "Mail"
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
ADMIN_NOTIFICATION_EMAIL=admin@powervegexim.com

# ── Gemini AI (existing) ──────────────────────────────────────
GEMINI_API_KEY=MY_GEMINI_API_KEY
